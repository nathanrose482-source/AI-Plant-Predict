# ════════════════════════════════════════════════════════════════════
#  Plant Vision — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── Gemini VLM Fallback ───────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_gemini_api_key
# Gemini model to use for VLM fallback (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# ── Confidence Gate ───────────────────────────────────────────────
# Minimum confidence for Tier-1 ONNX prediction to be accepted.
# Range: 0.0 – 1.0  (default: 0.75)
CONFIDENCE_THRESHOLD=0.75

# ── Model settings ────────────────────────────────────────────────
# Number of plant classes (must match training)
NUM_CLASSES=5

# ── Server ────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
